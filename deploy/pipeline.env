# ─────────────────────────────────────────────────────────────────────────────
#  WHERE YOUR PIPELINE BUILDS, PUSHES AND DEPLOYS. Edit, commit, push.
#
#  Every user builds their own image from this source and stores it in their own
#  registry: there is no shared/public image. `terraform -chdir=infra output -raw
#  pipeline_env` prints this file filled in for your account.
#
#  Empty values = not configured: the deploy workflow only prints a notice.
# ─────────────────────────────────────────────────────────────────────────────

# Image repository the pipeline pushes to and the cluster pulls from (no tag:
# the pipeline tags every build with the commit SHA). Supported:
#   Amazon ECR  123456789012.dkr.ecr.us-east-1.amazonaws.com/eks-healthcheck  (recommended: nodes already pull from ECR)
#   GHCR        ghcr.io/<your-github-user-or-org>/eks-healthcheck            (uses the workflow's GITHUB_TOKEN)
#   Any other   registry.example.com/team/eks-healthcheck                     (needs secrets REGISTRY_USERNAME and REGISTRY_PASSWORD)
IMAGE_REPOSITORY=

# Cluster to deploy to. Leave empty to only build and push the image.
EKS_CLUSTER_NAME=
AWS_REGION=

# IAM role GitHub Actions assumes through OIDC (created by infra/). Used for ECR
# pushes and for the deploy.
AWS_DEPLOY_ROLE_ARN=

# Kubernetes namespace for the release.
HELM_NAMESPACE=healthcheck
